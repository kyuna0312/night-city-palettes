# Box UK Contrast — tmux (generated by scripts/generate.py)
set -g mode-style "fg=#161e22,bg=#017c9d"
set -g message-style "fg=#b8c7cc,bg=#1b2228"
set -g message-command-style "fg=#b8c7cc,bg=#1b2228"
set -g pane-border-style "fg=#303b47"
set -g pane-active-border-style "fg=#017c9d"
set -g status-position bottom
set -g status-style "fg=#017c9d,bg=#111519"
set -g status-left "#[fg=#161e22,bg=#017c9d,bold] #S #[fg=#017c9d,bg=#111519]"
set -g status-right "#[fg=#60778c] %H:%M #[fg=#161e22,bg=#15b8ae,bold] #h "
setw -g window-status-style "fg=#60778c,bg=#111519"
setw -g window-status-format " #I #W "
setw -g window-status-current-style "fg=#161e22,bg=#15b8ae,bold"
setw -g window-status-current-format " #I #W "
setw -g window-status-activity-style "fg=#ffcb6e,bg=#111519"
