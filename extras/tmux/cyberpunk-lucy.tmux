# Cyberpunk: Edgerunners (Lucy) — tmux (generated by scripts/generate.py)
set -g mode-style "fg=#0a0e1a,bg=#37e0ff"
set -g message-style "fg=#c8d6f0,bg=#141a2e"
set -g message-command-style "fg=#c8d6f0,bg=#141a2e"
set -g pane-border-style "fg=#2a3454"
set -g pane-active-border-style "fg=#37e0ff"
set -g status-position bottom
set -g status-style "fg=#37e0ff,bg=#060812"
set -g status-left "#[fg=#0a0e1a,bg=#37e0ff,bold] #S #[fg=#37e0ff,bg=#060812]"
set -g status-right "#[fg=#5a6a8c] %H:%M #[fg=#0a0e1a,bg=#00d4d4,bold] #h "
setw -g window-status-style "fg=#5a6a8c,bg=#060812"
setw -g window-status-format " #I #W "
setw -g window-status-current-style "fg=#0a0e1a,bg=#00d4d4,bold"
setw -g window-status-current-format " #I #W "
setw -g window-status-activity-style "fg=#ffd93d,bg=#060812"
