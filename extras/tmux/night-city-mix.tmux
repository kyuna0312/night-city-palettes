# Night City Mix — tmux (generated by scripts/generate.py)
set -g mode-style "fg=#101a1f,bg=#2bbcd5"
set -g message-style "fg=#b6c5d3,bg=#15242d"
set -g message-command-style "fg=#b6c5d3,bg=#15242d"
set -g pane-border-style "fg=#2c3d4b"
set -g pane-active-border-style "fg=#2bbcd5"
set -g status-position bottom
set -g status-style "fg=#2bbcd5,bg=#0c1217"
set -g status-left "#[fg=#101a1f,bg=#2bbcd5,bold] #S #[fg=#2bbcd5,bg=#0c1217]"
set -g status-right "#[fg=#5b7189] %H:%M #[fg=#101a1f,bg=#0cc7c2,bold] #h "
setw -g window-status-style "fg=#5b7189,bg=#0c1217"
setw -g window-status-format " #I #W "
setw -g window-status-current-style "fg=#101a1f,bg=#0cc7c2,bold"
setw -g window-status-current-format " #I #W "
setw -g window-status-activity-style "fg=#f2c74b,bg=#0c1217"
