# Solarized Osaka — tmux (generated by scripts/generate.py)
set -g mode-style "fg=#00141a,bg=#2aa298"
set -g message-style "fg=#839495,bg=#002d38"
set -g message-command-style "fg=#839495,bg=#002d38"
set -g pane-border-style "fg=#22464f"
set -g pane-active-border-style "fg=#2aa298"
set -g status-position bottom
set -g status-style "fg=#2aa298,bg=#001014"
set -g status-left "#[fg=#00141a,bg=#2aa298,bold] #S #[fg=#2aa298,bg=#001014]"
set -g status-right "#[fg=#52727a] %H:%M #[fg=#00141a,bg=#15b8ae,bold] #h "
setw -g window-status-style "fg=#52727a,bg=#001014"
setw -g window-status-format " #I #W "
setw -g window-status-current-style "fg=#00141a,bg=#15b8ae,bold"
setw -g window-status-current-format " #I #W "
setw -g window-status-activity-style "fg=#b28600,bg=#001014"
